{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Mashin: FLAC",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/mashin-py-cli.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "http://192.168.1.2:8095",
                "--name", "Desktop SP",
                "--codec", "flac",
                "--buffer-capacity", "256",
                "--debug"
            ]
        },
